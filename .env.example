# ==============================================================================
# Konfigurasi Lingkungan - Minecraft Autonomous Companion
# ==============================================================================

# Database PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=syahriezas
PGPASSWORD=
PGDATABASE=minecraft_companion

# Konfigurasi Koneksi Pool Database
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Server Web Dashboard & Telemetry Hub (Port 8080)
PORT=8080
HOST=0.0.0.0

# DeepSeek AI Brain
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000

# Server Headless Minecraft Arena & Bot
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.20.1
MC_BOT_USERNAME=AutonomousCompanion

# Konfigurasi Batch Ingestion Telemetri
TELEMETRY_FLUSH_INTERVAL_MS=250
TELEMETRY_BATCH_THRESHOLD=50
TELEMETRY_MAX_BUFFER_SIZE=5000
